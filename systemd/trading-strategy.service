[Unit]
Description=Trading strategy (Azure) - WebSocket/I/O-bound process
# Only start once networking is fully ready (WebSocket to the exchange) —
# the same safeguard that turned out to be needed on Oracle: without this,
# the service sometimes tried to connect before DNS/routing was ready
# after boot.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azadmin
WorkingDirectory=/opt/trading-strategy
Environment=PYTHONUNBUFFERED=1
# python -u AND PYTHONUNBUFFERED=1 together — redundant, but on Oracle one
# without the other didn't always work, depending on how the process was
# wrapped (e.g. by an intermediary script). Kept as a double safeguard
# against "logs look empty even though the process is running".
ExecStart=/opt/trading-strategy/venv/bin/python3 -u /opt/trading-strategy/strategy.py

Restart=always
RestartSec=5

# Logs go to journald -> syslog -> Azure Monitor Agent -> Log Analytics
# (see bicep/modules/monitor.bicep, syslog dataFlows).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-strategy

[Install]
WantedBy=multi-user.target
